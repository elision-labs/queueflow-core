# Copy to .env and adjust. The server reads these (CLI flags override env).

# PostgreSQL connection string (any plain PostgreSQL 13+; no extensions).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Used only by `make test-pg` / the Postgres integration tests.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/queueflow_test

# Server tuning (all optional; shown with their defaults).
QUEUEFLOW_MODE=all
QUEUEFLOW_API_PORT=8000
QUEUEFLOW_METRICS_PORT=9090
QUEUEFLOW_WORKERS=10
QUEUEFLOW_DEFAULT_QUEUE=default
# Delete terminal jobs/workflows/dead letters older than this many hours.
# Unset (the default) keeps history forever.
# QUEUEFLOW_RETENTION_HOURS=168

# Log filter (tracing-subscriber EnvFilter syntax).
RUST_LOG=info

# Authentication. The server refuses to serve the API without BOTH a tenant
# credential source and a worker token, unless QUEUEFLOW_DEV=1 is set.
# Static tenant API keys as token:tenant pairs.
# QUEUEFLOW_API_KEYS=change-me-tenant-key:acme
# HS256 secret for tenant JWTs (sub = tenant id). May be combined with API keys.
# QUEUEFLOW_JWT_SECRET=change-me
# Credential for the worker-protocol endpoints (lease/heartbeat/complete/fail).
# QUEUEFLOW_WORKER_TOKEN=change-me-worker-token
# Comma-separated CORS origins (unset = permissive, for development only).
# QUEUEFLOW_CORS_ORIGINS=https://app.example.com
# Development mode: any non-empty token is tenant "tenant1" and the worker
# endpoints are open. Never set this on a reachable server.
# QUEUEFLOW_DEV=1

# ---- Docker Compose (docker-compose.yml at the repo root) --------------------
# `docker compose up -d --wait` reads this file for ${VAR} interpolation only;
# DATABASE_URL for the container is set inside docker-compose.yml (it points at
# the compose Postgres, not at the value above). The two credentials are
# mandatory: compose refuses to start until both are set here or in the shell.
#   QUEUEFLOW_API_KEYS=$(openssl rand -hex 24):acme
#   QUEUEFLOW_WORKER_TOKEN=$(openssl rand -hex 24)
# Optional compose knobs (defaults shown):
# POSTGRES_PASSWORD=queueflow
# QUEUEFLOW_IMAGE_TAG=0.2
# Host ports published for the container's 8000/9090.
# QUEUEFLOW_HOST_API_PORT=8000
# QUEUEFLOW_HOST_METRICS_PORT=9090
